# Copy this file to .env and adjust values for your environment.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Database ──────────────────────────────────────────────────────────────
# SQLite is the default for development (no DATABASE_URL needed).
# To use Postgres, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/zeaniv

# ── LLM Provider ──────────────────────────────────────────────────────────
# Options: ollama | gemini | mock
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini (used when LLM_PROVIDER=gemini) — free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── External APIs (optional) ──────────────────────────────────────────────
SERPAPI_KEY=
NEWS_API_KEY=

# ── Translation ───────────────────────────────────────────────────────────
# llm        — uses the configured LLM (default; works out of the box)
# local_http — POSTs to TRANSLATION_URL with a configurable JSON shape
TRANSLATION_PROVIDER=llm
TRANSLATION_URL=
TRANSLATION_TEXT_FIELD=text
TRANSLATION_TARGET_FIELD=target_lang
TRANSLATION_SOURCE_FIELD=source_lang
TRANSLATION_RESPONSE_FIELD=translation

# ── Kashmiri TTS ──────────────────────────────────────────────────────────
# Providers:
#   local_http   — POST to TTS_URL (Modal, your own FastAPI server, etc.)
#   local_matcha — load a Bolbosh / Matcha-TTS checkpoint in-process
TTS_PROVIDER=local_http

# local_http config — point TTS_URL at your local or hosted TTS server.
# Response should be either raw audio (Content-Type: audio/*) or
# JSON {"audio": "<base64>"}.
TTS_URL=
TTS_TEXT_FIELD=text
TTS_LANG_FIELD=lang
TTS_STEPS_FIELD=n_timesteps        # JSON key for diffusion-step count; "" to omit
TTS_AUDIO_FIELD=audio
TTS_AUTH_BEARER=

# local_matcha config — only used when TTS_PROVIDER=local_matcha.
# Requires the Bolbosh fork of matcha-tts (NOT pypi matcha-tts) and
# KashmiriNormalizer:
#   pip install -e /path/to/Bolbosh
#   pip install git+https://github.com/abdulmuizz0903/KashmiriNormalizer
# TTS_LOCAL_BOLBOSH_PATH lets you skip the editable install — we'll
# prepend it to sys.path at load time.
TTS_LOCAL_CKPT_PATH=/Users/farhan/klm/model.ckpt
TTS_LOCAL_VOCODER_PATH=
TTS_LOCAL_BOLBOSH_PATH=/Users/farhan/klm/Bolbosh
TTS_LOCAL_DEVICE=auto                 # auto | cpu | cuda | mps
TTS_LOCAL_SPEAKER_ID=423
TTS_LOCAL_SPEAKING_RATE=1.0
TTS_LOCAL_N_TIMESTEPS=20

# ── Async runner ──────────────────────────────────────────────────────────
# When False, agents run synchronously inside the request (great for dev).
# When True, sessions are queued via Django Q and run by a worker process.
USE_DJANGO_Q=False

# ── JWT lifetimes ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
